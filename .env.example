# The project endpoint shown in your Microsoft Foundry project.
# Example: https://my-resource.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_ENDPOINT=

# Use the name of your deployed model (or an available direct model).
FOUNDRY_MODEL=gpt-5-mini

# Optional: set to true only for local browser experimentation.
APP_ALLOW_ORIGINS=http://localhost:3000
