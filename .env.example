# The project endpoint shown in your Microsoft Foundry project.
# Example: https://my-resource.services.ai.azure.com/api/projects/my-project
FOUNDRY_PROJECT_ENDPOINT=

# Use the name of your deployed model (or an available direct model).
FOUNDRY_MODEL=gpt-5-mini

# Optional: comma-separated browser origins allowed to call the API (CORS).
APP_ALLOW_ORIGINS=http://localhost:3000

# "foundry" (default) calls your model. "offline" answers extractively from the sources,
# without Azure: handy for a first look, CI and as a free evaluation baseline.
MICRO_FOUNDRY_PROVIDER=foundry
